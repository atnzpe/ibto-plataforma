<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Só HTTPS no servidor (no localhost não vale).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ib-to\.org$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Homologação (issue #35): senha e noindex só em cursos-homolog.ib-to.org e só
# no HTTPS (no HTTP vale primeiro o redirecionamento acima, sem pedir senha).
# Usa o mesmo arquivo de senhas da homologação do site (homolog.ib-to.org),
# então a equipe entra com o mesmo usuário e senha. Guia:
# docs/publicacao-homologacao.md.
#
# EXCEÇÃO (15/10/2026, blog #61): ficam SEM senha só os pedidos de LEITURA
# (GET) de /api/publico/... (os posts já publicados, para o bloco "Últimas do
# IBTO" do site de testes) e de /imagens/... (capas e fotos). O site busca
# esses dados "de fora", sem a senha, e sem a exceção receberia "acesso
# negado". Esses endereços já se protegem sozinhos: só entregam o que está
# publicado (rascunho dá "não existe"). O resto da homologação continua com senha.
# THE_REQUEST é a primeira linha do pedido, como chegou (ex.: "GET /api/publico/blog HTTP/1.1"):
# não muda quando o Laravel redireciona tudo para o index.php por dentro.
<If "%{HTTP_HOST} == 'cursos-homolog.ib-to.org' && %{HTTPS} == 'on' && %{THE_REQUEST} !~ m#^GET /(api/publico|imagens)/#">
    AuthType Basic
    AuthName "Homologacao IBTO Cursos"
    AuthUserFile "/home1/edua1187/.htpasswds/homolog.ib-to.org/passwd"
    Require valid-user
</If>

<IfModule mod_headers.c>
    <If "%{HTTP_HOST} == 'cursos-homolog.ib-to.org'">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>
